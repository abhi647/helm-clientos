# Copy to .env.local for local dev. In Vercel, set these under Project → Settings → Environment Variables.
# Never commit real values.

# Public URL of the app (used in email links). Local: http://localhost:3000
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Supabase → Project Settings → API Keys (local: `supabase status -o env`)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# "true" shows "Continue with Google" for the Seven Billion team (enable the Google provider in Supabase first)
NEXT_PUBLIC_GOOGLE_SIGNIN=false

# Server-only. Bypasses RLS; used for the email outbox, integrations and invites.
SUPABASE_SECRET_KEY=

# Resend (notification emails). Leave empty locally: emails are logged and marked skipped.
RESEND_API_KEY=
EMAIL_FROM="Seven Billion <updates@your-verified-domain.com>"
EMAIL_REPLY_TO=
# optional: send from a Microsoft 365 mailbox instead (README, Email delivery)
MS_TENANT_ID=
MS_CLIENT_ID=
MS_CLIENT_SECRET=
MS_SENDER=

# Random string (32+ chars). Vercel Cron sends it as "Authorization: Bearer <CRON_SECRET>".
CRON_SECRET=

# HubSpot (optional): private app token + the app's client secret for webhook signatures
HUBSPOT_ACCESS_TOKEN=
HUBSPOT_WEBHOOK_SECRET=
# Deal stage ids that mean "closed won" (comma separated)
HUBSPOT_CLOSED_WON_STAGES=closedwon

# Zoho Books (optional): self-client OAuth with scopes ZohoBooks.invoices.READ,ZohoBooks.customerpayments.READ
ZOHO_CLIENT_ID=
ZOHO_CLIENT_SECRET=
ZOHO_REFRESH_TOKEN=
ZOHO_ORGANIZATION_ID=
# zoho.in | zoho.com | zoho.eu ...
ZOHO_DOMAIN=zoho.in

# Virus scanning: a ClamAV daemon (clamd) reachable over TCP. Run the official clamav/clamav image on a private
# network (e.g. Fly.io, Railway or a small VM) and point these at it. Locally: docker run -p 3310:3310 clamav/clamav:stable
CLAMAV_HOST=
CLAMAV_PORT=3310
# "true": files stay locked until a scanner has checked them. Leave false only while no scanner is set up.
REQUIRE_VIRUS_SCAN=false

# Local only: password for seeded demo users (sign-in is by magic link; this is a fallback)
SEED_PASSWORD=local-dev-only-password
